    <string name="le_audio_title">OPPO LE Audio</string>
    <string name="le_audio_summary">Connection policy, earbud link stability and OPPO protocol compatibility</string>
    <string name="le_audio_enable">Enable OPPO LE Audio</string>
    <string name="le_audio_enable_summary">Enable the complete compatibility path. After upgrading, restart Bluetooth and reopen the case. Enabling only system LC3 may disable classic/HFP and prevent the AT handshake.</string>
    <string name="le_audio_protocol">Advanced · OPPO protocol compatibility</string>
    <string name="le_audio_at">Respond to vendor AT commands</string>
    <string name="le_audio_at_summary">Answer VDID / VDSF / OESF / VDSP requests using the OPPO protocol</string>
    <string name="le_audio_vdsp">Send +VDSP=1,1</string>
    <string name="le_audio_vdsp_summary">Send LE Audio initialization 500 ms after the HFP handshake completes</string>
    <string name="le_audio_vendor_id">Vendor ID</string>
    <string name="le_audio_vendor_id_summary">OPPO vendor ID; default 1946 (decimal, 0–65535)</string>
    <string name="le_audio_oesf_mask">OESF feature mask</string>
    <string name="le_audio_oesf_mask_summary">Mask requested features; default 0x3f (decimal or hexadecimal, 0–65535)</string>
    <string name="le_audio_save_protocol">Save protocol parameters</string>
    <string name="le_audio_reset">Restore advanced defaults</string>
    <string name="le_audio_latency_group">Latency and performance</string>
    <string name="le_audio_connection_group">Connection policy and scheduling</string>
    <string name="le_audio_stability_group">Link retention and stability</string>
    <string name="le_audio_game_context">Global low latency</string>
    <string name="le_audio_game_context_summary">Off by default. Announce game activity for low-latency negotiation, potentially reducing bitrate and quality. Results depend on system configuration; playback may reset the state.</string>
    <string name="le_audio_le_first">Prioritize LE Audio</string>
    <string name="le_audio_le_first_summary">Give LE one attempt on an incoming classic connection, then allow classic fallback after failure. Does not globally force dual mode.</string>
    <string name="le_audio_poke">Initiate LE handshake</string>
    <string name="le_audio_poke_summary">Request one direct connection during an LE-priority incoming event, without polling or repeated dialing.</string>
    <string name="le_audio_wake_classic">Reconnect classic after Bluetooth restart</string>
    <string name="le_audio_wake_classic_summary">Request one full connection to the classic lead when services are ready or system reconnection starts, restoring HFP initialization. Does not dial classic on case-close disconnection events.</string>
    <string name="le_audio_fix_policy">Repair blocked connection policy</string>
    <string name="le_audio_fix_policy_summary">Block internal FORBIDDEN writes and repair A2DP/HFP policy before connecting so LC3 does not lock out AT initialization. User-disabled profiles are tracked within this process; disabled policy inherited from an earlier process may be repaired.</string>
    <string name="le_audio_gate_hfp">Block HFP during LE priority</string>
    <string name="le_audio_gate_hfp_summary">Off by default; keep it off. Enco X3 needs HFP/AT for earbud coordination. Blocking it may prevent initialization or cause single-ear audio.</string>
    <string name="le_audio_hold_gatt">Retain GATT link ownership</string>
    <string name="le_audio_hold_gatt_summary">Attach a direct GATT holder after LE ACL establishment to prevent idle disconnection and single-ear dropouts. May increase power usage; released on manual disconnect, ACL loss or feature disable.</string>
    <string name="le_audio_complete_group">Complete both LE Audio earbuds</string>
    <string name="le_audio_complete_group_summary">When one member connects or another fails, attempt the missing member once while a group peer is online. Java CONNECTED alone does not guarantee stable links for both earbuds.</string>
    <string name="le_audio_adopt_contexts">Repair available audio contexts</string>
    <string name="le_audio_adopt_contexts_summary">Restore empty-context repair and lead activation after both earbuds are ready. Prefer native reports for that group; never overwrite a nonzero system value.</string>
    <string name="le_audio_devices">Select target devices</string>
    <string name="le_audio_devices_count">%1$d MAC addresses selected; no devices are managed when empty</string>
    <string name="le_audio_devices_hint">Select paired earbuds requiring LE Audio compatibility. Matching uses MAC addresses with system mappings for classic and LE group members, never device names.</string>
